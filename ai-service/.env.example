# Copy to .env and fill in the placeholder values: cp .env.example .env
# Non-secret values below are the defaults from app/config.py.
# Every key must match a field in app/config.py (unknown keys fail startup).

APP_NAME=ai-service
APP_PORT=8005

# LLM provider: groq | gemini | ollama
LLM_PROVIDER=groq

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Product Service
PRODUCT_SERVICE_URL=http://localhost:8001

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai-service-group
KAFKA_ORDER_PLACED_TOPIC=order-placed
KAFKA_AI_NOTIFICATION_TOPIC=ai-notification-ready
KAFKA_PRODUCT_UPDATED_TOPIC=product-updated

# Redis cache (set CACHE_ENABLED=false to bypass)
CACHE_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
CACHE_CATALOG_TTL=900
CACHE_LLM_TTL=21600
