# Copy to .env and fill in the placeholder values: cp .env.example .env
# Non-secret values below are the defaults from app/config.py.
# Every key must match a field in app/config.py (unknown keys fail startup).

APP_NAME=api-gateway
APP_PORT=9000

# Downstream services
PRODUCT_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8005
SEARCH_SERVICE_URL=http://localhost:8006

# Keycloak
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=microservices
KEYCLOAK_CLIENT_ID=api-gateway
# Optional: fetch signing keys from here instead of KEYCLOAK_URL (docker-compose sets http://keycloak:8080)
KEYCLOAK_INTERNAL_URL=

# Rate limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AI=15/minute

# Set to true to require a Keycloak JWT on every request
AUTH_ENABLED=false
