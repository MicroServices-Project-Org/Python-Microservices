# Copy to .env and fill in the placeholder values: cp .env.example .env
# Read by docker-compose.yml only (infrastructure credentials).
# Each service has its own <service>/.env.example for app settings.

# MongoDB
MONGO_USERNAME=your-mongo-user
MONGO_PASSWORD=your-mongo-password

# PostgreSQL — order-service and inventory-service .env must use the same user/password
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password

# Keycloak admin console
KEYCLOAK_ADMIN=your-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=your-keycloak-password
