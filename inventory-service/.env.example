# Copy to .env and fill in the placeholder values: cp .env.example .env
# Non-secret values below are the defaults from app/config.py.
# Every key must match a field in app/config.py (unknown keys fail startup).

APP_NAME=inventory-service
APP_PORT=8003

# PostgreSQL — user/password must match POSTGRES_USER/POSTGRES_PASSWORD in the root .env
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=inventory_db

# Kafka: order-cancelled events restock the cancelled items
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDER_CANCELLED_TOPIC=order-cancelled
KAFKA_GROUP_ID=inventory-group
