# Copy to .env and fill in the placeholder values: cp .env.example .env
# Non-secret values below are the defaults from app/config.py.
# Every key must match a field in app/config.py (unknown keys fail startup).

APP_NAME=product-service
APP_PORT=8001

# MongoDB. Leave the user empty to connect without auth; the docker-compose
# mongodb container requires auth (root user from the root .env).
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
DB_NAME=product_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCT_TOPIC=product-updated
