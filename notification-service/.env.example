# Copy to .env and fill in the placeholder values: cp .env.example .env
# Non-secret values below are the defaults from app/config.py.
# Every key must match a field in app/config.py (unknown keys fail startup).

APP_NAME=notification-service
APP_PORT=8004

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=notification-group
KAFKA_ORDER_PLACED_TOPIC=order-placed
KAFKA_ORDER_CANCELLED_TOPIC=order-cancelled
KAFKA_AI_NOTIFICATION_READY_TOPIC=ai-notification-ready

# Gmail SMTP — use an App Password, not your account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=FastAPI Store

# Set to true to actually send email (requires the SMTP values above)
EMAIL_ENABLED=false

# Redis — idempotency keys
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_IDEMPOTENCY_TTL=604800
