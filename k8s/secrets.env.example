# Copy to k8s/secrets.env (gitignored) and fill in. deploy.sh creates the
# `app-secrets` Secret from it, and copies this file if secrets.env is missing.
MONGO_USERNAME=admin
MONGO_PASSWORD=password
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# Optional: the AI endpoints return errors without a key for LLM_PROVIDER (groq by default)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: only used when EMAIL_ENABLED=true
SMTP_USERNAME=
SMTP_PASSWORD=
